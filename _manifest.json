{
  "manifest_version": 2,
  "id": "omsociety.flandora-adapter",
  "version": "1.0.1",
  "name": "Flandora 微信适配器",
  "description": "通过 OneBot v11 正向 WebSocket 把 Flandora 桥接的微信个人号（群聊与私聊）接入 MaiBot。",
  "author": {
    "name": "OMSociety",
    "url": "https://github.com/OMSociety"
  },
  "license": "AGPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/OMSociety/MaiBot-Flandora-Adapter",
    "homepage": "https://github.com/OMSociety/MaiBot-Flandora-Adapter",
    "documentation": "https://github.com/OMSociety/MaiBot-Flandora-Adapter/blob/main/README.md",
    "issues": "https://github.com/OMSociety/MaiBot-Flandora-Adapter/issues"
  },
  "plugin_type": "adapter",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "message-circle",
      "background": "#E5EAEC"
    }
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.7.0",
    "max_version": "2.99.99"
  },
  "capabilities": [],
  "dependencies": [
    {
      "type": "python_package",
      "name": "websockets",
      "version_spec": ">=12.0"
    }
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
